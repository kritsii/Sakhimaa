# SakhiMaa - Medical Report Analysis Configuration

# AI Provider to use for clinical report explanation: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Specific Gemini model (defaults to gemini-3.5-flash-lite, automatically falls back if needed)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI API configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size in MB (default: 10)
MAX_FILE_SIZE_MB=10

# Standalone server port (default: 5001)
PORT=5001
